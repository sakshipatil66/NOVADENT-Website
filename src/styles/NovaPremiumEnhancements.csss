
/* =========================================================
   NOVADENT — PREMIUM VISUAL ENHANCEMENTS
   Additive stylesheet: preserves existing page content.
   Palette: white, soft mint, navy and teal.
========================================================= */

:root {
  --nova-ink: #163b43;
  --nova-ink-deep: #102f36;
  --nova-teal: #168b88;
  --nova-teal-dark: #0f716f;
  --nova-mint: #f2faf8;
  --nova-white: #ffffff;
  --nova-muted: #667b80;
  --nova-line: rgba(22, 59, 67, 0.12);
  --nova-shadow: 0 18px 50px rgba(20, 55, 62, 0.09);
  --nova-shadow-hover: 0 26px 65px rgba(20, 55, 62, 0.16);
  --nova-radius: 22px;
  --nova-ease: cubic-bezier(0.22, 1, 0.36, 1);
}

/* 1. Base typography and page rendering */

html {
  scroll-behavior: smooth;
  scroll-padding-top: 90px;
}

body {
  color: var(--nova-ink);
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
}

img {
  max-width: 100%;
}

main img {
  transition:
    transform 800ms var(--nova-ease),
    filter 600ms ease;
}

::selection {
  background: rgba(22, 139, 136, 0.2);
  color: var(--nova-ink-deep);
}

/* 2. Shared page section rhythm */

main > section {
  position: relative;
}

main > section:nth-of-type(even) {
  background-color: var(--nova-mint);
}

main > section img {
  display: block;
  max-width: 100%;
}

.container {
  width: min(1180px, calc(100% - 48px));
  margin-inline: auto;
}

.section {
  padding-block: clamp(64px, 8vw, 112px);
}

/* 3. Premium headings */

main h1,
main h2,
main h3 {
  color: var(--nova-ink-deep);
  text-wrap: balance;
}

main h1,
main h2 {
  letter-spacing: -0.045em;
}

main h1 {
  line-height: 1.04;
}

main h2 {
  line-height: 1.12;
}

main p {
  line-height: 1.8;
}

.eyebrow {
  letter-spacing: 0.15em;
  font-size: 0.75rem;
  font-weight: 750;
}

/* 4. Shared button enhancement */

main a[class*="Button"],
main button,
main a.btn,
main .btn {
  transition:
    transform 250ms var(--nova-ease),
    box-shadow 250ms ease,
    background-color 250ms ease,
    border-color 250ms ease;
}

main button,
main a {
  -webkit-tap-highlight-color: transparent;
}

main a[class*="Button"]:hover,
main a.btn:hover,
main .btn:hover {
  transform: translateY(-3px);
}

main button:hover {
  box-shadow: 0 10px 26px rgba(22, 139, 136, 0.14);
}

main a:focus-visible,
main button:focus-visible,
main input:focus-visible,
main select:focus-visible,
main textarea:focus-visible {
  outline: 3px solid rgba(22, 139, 136, 0.5);
  outline-offset: 4px;
}

/* 5. Cards — services, doctors, reviews and values */

.serviceCard,
.service-card,
.doctorCard,
.doctor-card,
.reviewCard,
.review-card,
.valueCard,
.value-card,
.treatmentCard,
.treatment-card,
.galleryCard,
.gallery-card {
  border: 1px solid var(--nova-line);
  border-radius: var(--nova-radius);
  box-shadow: 0 8px 28px rgba(20, 55, 62, 0.045);
  transition:
    transform 350ms var(--nova-ease),
    box-shadow 350ms ease,
    border-color 350ms ease;
}

.serviceCard:hover,
.service-card:hover,
.doctorCard:hover,
.doctor-card:hover,
.reviewCard:hover,
.review-card:hover,
.valueCard:hover,
.value-card:hover,
.treatmentCard:hover,
.treatment-card:hover,
.galleryCard:hover,
.gallery-card:hover {
  transform: translateY(-7px);
  box-shadow: var(--nova-shadow-hover);
  border-color: rgba(22, 139, 136, 0.28);
}

/* 6. Images in cards */

.serviceCard img,
.service-card img,
.doctorCard img,
.doctor-card img,
.treatmentCard img,
.treatment-card img,
.galleryCard img,
.gallery-card img {
  transition: transform 700ms var(--nova-ease);
}

.serviceCard:hover img,
.service-card:hover img,
.doctorCard:hover img,
.doctor-card:hover img,
.treatmentCard:hover img,
.treatment-card:hover img,
.galleryCard:hover img,
.gallery-card:hover img {
  transform: scale(1.045);
}

/* Avoid image zoom escaping card boundaries. */
.serviceCard,
.service-card,
.doctorCard,
.doctor-card,
.treatmentCard,
.treatment-card,
.galleryCard,
.gallery-card {
  overflow: hidden;
}

/* 7. Page hero — subtle cinematic entrance */

.pageHero,
.aboutHero {
  isolation: isolate;
}

.pageHero img,
.aboutHeroImage img {
  object-fit: cover;
}

.aboutHeroImage img {
  transform: scale(1.015);
  animation: novaHeroImageReveal 1.2s var(--nova-ease) both;
}

.aboutHeroContent {
  animation: novaHeroTextReveal 900ms 120ms var(--nova-ease) both;
}

.aboutHeroOverlay {
  pointer-events: none;
}

@keyframes novaHeroImageReveal {
  from {
    opacity: 0.65;
    transform: scale(1.07);
  }
  to {
    opacity: 1;
    transform: scale(1.015);
  }
}

@keyframes novaHeroTextReveal {
  from {
    opacity: 0;
    transform: translateY(24px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 8. About page — values and technology */

.aboutPage .valueCard {
  background: var(--nova-white);
}

.aboutPage .technologyImage,
.aboutPage .aboutIntroImage {
  border-radius: var(--nova-radius);
  overflow: hidden;
}

.aboutPage .technologyImage img,
.aboutPage .aboutIntroImage img {
  transition: transform 900ms var(--nova-ease);
}

.aboutPage .technologyImage:hover img,
.aboutPage .aboutIntroImage:hover img {
  transform: scale(1.035);
}

/* 9. Appointment and contact forms */

form input,
form select,
form textarea {
  max-width: 100%;
  border-radius: 12px;
  transition:
    border-color 220ms ease,
    box-shadow 220ms ease,
    background-color 220ms ease;
}

form input:focus,
form select:focus,
form textarea:focus {
  border-color: var(--nova-teal);
  box-shadow: 0 0 0 4px rgba(22, 139, 136, 0.09);
}

form textarea {
  resize: vertical;
}

form button[type="submit"] {
  cursor: pointer;
}

/* 10. Gallery — image presentation */

main [class*="gallery"] img {
  height: auto;
  max-width: 100%;
}

main [class*="gallery"] a,
main [class*="gallery"] button {
  cursor: pointer;
}

/* 11. Navigation — enhancement only when these classes exist */

.navbar,
nav.navbar,
.siteNavbar {
  z-index: 1000;
}

.navbar a,
.siteNavbar a {
  transition: color 220ms ease;
}

.navbar a:hover,
.siteNavbar a:hover {
  color: var(--nova-teal);
}

/* 12. Responsive tablet */

@media (max-width: 900px) {
  .container {
    width: min(100% - 36px, 720px);
  }

  .section {
    padding-block: 68px;
  }

  main h1 {
    font-size: clamp(2.4rem, 7vw, 4.4rem);
  }

  main h2 {
    font-size: clamp(1.9rem, 5vw, 3.2rem);
  }
}

/* 13. Responsive mobile */

@media (max-width: 600px) {
  .container {
    width: calc(100% - 32px);
  }

  .section {
    padding-block: 54px;
  }

  main p {
    line-height: 1.72;
  }

  .serviceCard,
  .service-card,
  .doctorCard,
  .doctor-card,
  .reviewCard,
  .review-card,
  .valueCard,
  .value-card,
  .treatmentCard,
  .treatment-card,
  .galleryCard,
  .gallery-card {
    border-radius: 17px;
  }

  .serviceCard:hover,
  .service-card:hover,
  .doctorCard:hover,
  .doctor-card:hover,
  .reviewCard:hover,
  .review-card:hover,
  .valueCard:hover,
  .value-card,
  .treatmentCard:hover,
  .treatment-card:hover,
  .galleryCard:hover,
  .gallery-card:hover {
    transform: none;
  }

  main a[class*="Button"]:hover,
  main a.btn:hover,
  main .btn:hover {
    transform: none;
  }

  form input,
  form select,
  form textarea,
  form button {
    font-size: 16px;
  }
}

/* 14. Respect reduced-motion preferences */

@media (prefers-reduced-motion: reduce) {
  html {
    scroll-behavior: auto;
  }

  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }
}